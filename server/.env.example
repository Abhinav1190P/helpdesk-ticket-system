# Server
PORT=5001
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/helpdesk

# JWT — use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Used by `npm run seed:admin` to create the first admin account
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@helpdesk.dev
ADMIN_PASSWORD=Admin@12345
